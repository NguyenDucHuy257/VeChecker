# Tai khoan nguon. Khong commit file .env that.
VR_USERNAME=
VR_PASSWORD=

# Mot hoac nhieu Telegram numeric ID, cach nhau bang dau phay.
# Phase 1 chi dung de seed admin trong SQLite.
TELEGRAM_ADMIN_IDS=
TELEGRAM_BOT_TOKEN=

VR_BASE_URL=https://app.vr.org.vn/ptpublicweb/
DATABASE_PATH=runtime/dktle.sqlite3
CAPTCHA_DIR=runtime/captcha
REQUEST_TIMEOUT_SECONDS=15
SOURCE_REQUEST_ATTEMPTS=3
SOURCE_RETRY_DELAY_SECONDS=1
MAX_CAPTCHA_ATTEMPTS=3
VERIFY_SSL=true
LOG_LEVEL=INFO
CANDIDATE_DELAY_SECONDS=2

# Stability script Phase 1
STABILITY_INPUT_FILE=tests/live_plates.txt
STABILITY_DELAY_SECONDS=2

# Phase 2 Telegram/worker
MAX_WORKERS=2
JOB_QUEUE_SIZE=20
TELEGRAM_POLL_TIMEOUT_SECONDS=25
USER_RATE_LIMIT_SECONDS=2
SOURCE_SERIALIZE_REQUESTS=true

# Phase 2 CAPTCHA. Auto chi bat khi co model va MODEL_INFO hop le.
CAPTCHA_MODE=auto
CAPTCHA_MODEL_PATH=models/captcha/model.onnx
CAPTCHA_CONFIDENCE_THRESHOLD=0.60
